# PostgreSQL connection string (Railway: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@localhost:5432/rayed"

# One-time token required to create the first platform owner at /setup.
# Generate with: openssl rand -hex 32 — remove it after setup is complete.
SETUP_TOKEN=""

# Public base URL, used for invitation and password-reset links.
APP_URL="http://localhost:3000"

# Optional: Encar (Korean car market) API key for the vehicle market page.
ENCAR_API_KEY=""
